# =========================================================
# ANVESHANA SERVER BACKEND ENVIRONMENT VARIABLES (.env)
# =========================================================

# Express HTTP Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# JWT RBAC Secret Key
JWT_SECRET=anveshana_dpi_protocol_secret_2026_jwt_token_key

# Comma-separated allowed browser origins. Leave empty for hackathon LAN mode.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Python FastAPI ML Microservice URL
ML_SERVICE_URL=http://localhost:8000

# SHA-256 Cryptographic Receipt Private Salt
CRYPTO_RECEIPT_SALT=anveshana_sha256_ndlm_salt_2026

# Database Connection URI (Optional PostgreSQL / MongoDB / Redis)
DATABASE_URL=postgresql://anveshana:secret@localhost:5432/anveshana_db
